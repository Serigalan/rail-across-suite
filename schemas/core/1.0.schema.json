{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "core",
  "title": "Rail-Data-Core, domain core 1.0",
  "description": "The base every module depends on: the net (tracks, switches and connectors), what stands on it for every discipline (platforms, end marks), the reference data (km lines, the operational point register) and the construction stages. Written by the layout tool, carried by the core library. See docs/data-model.md.",
  "type": "object",
  "required": ["fields", "collections"],
  "additionalProperties": false,
  "properties": {
    "fields": { "$ref": "#/$defs/Fields" },
    "collections": {
      "type": "object",
      "required": ["tracks", "switches", "platforms", "endMarks", "kmLines", "operationalPoints"],
      "additionalProperties": false,
      "properties": {
        "tracks": { "type": "array", "items": { "$ref": "#/$defs/Track" } },
        "switches": { "type": "array", "items": { "$ref": "#/$defs/Switch" } },
        "platforms": { "type": "array", "items": { "$ref": "#/$defs/Platform" } },
        "endMarks": { "type": "array", "items": { "$ref": "#/$defs/EndMark" } },
        "kmLines": { "type": "array", "items": { "$ref": "#/$defs/KmLine" } },
        "operationalPoints": { "type": "array", "items": { "$ref": "#/$defs/OperationalPoint" } }
      }
    }
  },
  "$defs": {
    "Id": {
      "description": "The id of an object, unique in its collection; a UUID in lower case by convention.",
      "type": "string",
      "minLength": 1
    },
    "Ref": {
      "description": "A reference to an object by its bare id. Where a property is a Ref, its `x-target` names the collection it points into.",
      "type": "string",
      "minLength": 1
    },
    "Text": { "type": "string" },
    "Label": {
      "description": "A number as people write it: a line or track number, sometimes with letters.",
      "type": ["string", "number"]
    },
    "Epsg": { "type": "integer", "minimum": 1 },
    "Point": {
      "description": "[easting, northing] in m, in the plane of the object that states it.",
      "type": "array",
      "items": { "type": "number" },
      "minItems": 2,
      "maxItems": 3
    },
    "Side": { "enum": ["left", "right"] },
    "Endpoint": { "enum": ["BEGIN", "END"] },
    "LineCategory": { "enum": ["main", "secondary", "s_bahn"] },

    "TrackEnd": {
      "description": "One end of a track: what a switch port, a connector or an end mark holds.",
      "type": "object",
      "required": ["trackId", "endpoint"],
      "additionalProperties": false,
      "properties": {
        "trackId": { "$ref": "#/$defs/Ref", "x-target": "core.tracks" },
        "endpoint": { "$ref": "#/$defs/Endpoint" }
      }
    },
    "TrackLocation": {
      "description": "Where an object stands, as one value (R5), stating its anchor (R11): `station` follows the track, `plane` keeps its place. Side and offset are seen in the direction of stationing; `direction` up = towards END.",
      "oneOf": [
        {
          "type": "object",
          "required": ["anchor", "trackId", "station"],
          "additionalProperties": false,
          "properties": {
            "anchor": { "const": "station" },
            "trackId": { "$ref": "#/$defs/Ref", "x-target": "core.tracks" },
            "station": { "type": "number" },
            "side": { "$ref": "#/$defs/Side" },
            "offset": { "type": "number", "minimum": 0 },
            "direction": { "enum": ["up", "down"] }
          }
        },
        {
          "type": "object",
          "required": ["anchor", "easting", "northing", "epsg"],
          "additionalProperties": false,
          "properties": {
            "anchor": { "const": "plane" },
            "easting": { "type": "number" },
            "northing": { "type": "number" },
            "epsg": { "$ref": "#/$defs/Epsg" },
            "bearing": { "type": "number" }
          }
        }
      ]
    },
    "TrackRange": {
      "description": "A stretch of one track, as one value (R5): from startStation to endStation, on a side.",
      "type": "object",
      "required": ["anchor", "trackId", "startStation", "endStation"],
      "additionalProperties": false,
      "properties": {
        "anchor": { "const": "station" },
        "trackId": { "$ref": "#/$defs/Ref", "x-target": "core.tracks" },
        "startStation": { "type": "number" },
        "endStation": { "type": "number" },
        "side": { "$ref": "#/$defs/Side" }
      }
    },
    "TrackPath": {
      "description": "A run of tracks in running order; the direction each one is run is derived from where they meet.",
      "type": "object",
      "required": ["trackIds"],
      "additionalProperties": false,
      "properties": {
        "trackIds": {
          "type": "array",
          "items": { "$ref": "#/$defs/Ref", "x-target": "core.tracks" }
        }
      }
    },
    "Lifespan": {
      "description": "The first construction stage an object exists in and the first it no longer exists in; an absent end is open, no lifespan at all means existing and staying (decision 0003).",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": false,
      "properties": {
        "from": { "$ref": "#/$defs/Ref", "x-target": "core.fields.stages" },
        "to": { "$ref": "#/$defs/Ref", "x-target": "core.fields.stages" }
      }
    },

    "Stage": {
      "type": "object",
      "required": ["id"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "$ref": "#/$defs/Text" }
      }
    },
    "Fields": {
      "description": "The project's own fields. `stages` is the ordered list of construction stages: the first is the existing state, the last the final state.",
      "type": "object",
      "required": ["id", "stages"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "title": { "$ref": "#/$defs/Text" },
        "description": { "$ref": "#/$defs/Text" },
        "creator": { "$ref": "#/$defs/Text" },
        "createdAt": { "$ref": "#/$defs/Text" },
        "crsSystem": { "$ref": "#/$defs/Text" },
        "lineCategory": { "$ref": "#/$defs/LineCategory" },
        "gaugeProfile": { "$ref": "#/$defs/Text" },
        "stages": { "type": "array", "items": { "$ref": "#/$defs/Stage" }, "minItems": 2 }
      }
    },

    "Element": {
      "description": "One design element of a track: straight (0), arc (1) or transition (2). No station, no polyline: stations are the running sum of the lengths, drawn geometry is derived.",
      "type": "object",
      "required": ["elementType", "startNode", "endNode", "length"],
      "additionalProperties": false,
      "properties": {
        "elementType": { "enum": [0, 1, 2] },
        "epsg": { "$ref": "#/$defs/Epsg", "description": "The plane the element is stated in, where it says so: its track's (a finding of the chain checks where not)." },
        "startNode": { "$ref": "#/$defs/Point" },
        "endNode": { "$ref": "#/$defs/Point" },
        "bearing": { "type": "number" },
        "endBearing": { "type": "number" },
        "length": { "type": "number", "minimum": 0 },
        "radius": { "type": ["number", "null"] },
        "r1": { "type": ["number", "null"] },
        "r2": { "type": ["number", "null"] },
        "transitionType": { "enum": ["clothoid", "bloss"] },
        "cant": { "type": "number" },
        "cantStart": { "type": "number" },
        "cantEnd": { "type": "number" },
        "cantException": { "$ref": "#/$defs/Text" },
        "role": { "enum": ["follow", "intermediate"] },
        "reasons": { "type": "object", "additionalProperties": { "type": "string" } },
        "speed": { "type": ["number", "null"], "minimum": 0 },
        "switchBranch": { "type": "boolean" },
        "switchRoute": { "enum": ["main", "branch", "cross", "slip1", "slip2"] },
        "switchId": { "$ref": "#/$defs/Ref", "x-target": "core.switches" },
        "switchHint": { "$ref": "#/$defs/Text", "description": "Why an import could not build the switch this element belongs to: form, number, reason." }
      }
    },
    "HeightPoint": {
      "description": "A point of a track's vertical tangent polygon: station [m], height of the rail that is not raised [m], vertical curve radius and what governs it, and how it depends on another point.",
      "type": "object",
      "required": ["station", "z"],
      "additionalProperties": false,
      "properties": {
        "station": { "type": "number" },
        "z": { "type": "number" },
        "rv": { "type": ["number", "null"] },
        "la": { "type": ["number", "null"] },
        "reason": { "$ref": "#/$defs/Text" },
        "locked": { "type": "boolean" },
        "id": { "$ref": "#/$defs/Id" },
        "dep": { "$ref": "#/$defs/Ref", "x-target": "the id of another height point" },
        "depMode": { "enum": ["lds", "continueBefore", "continueAfter", "wa", "continue"] },
        "free": { "type": "boolean" }
      }
    },
    "Superstructure": {
      "type": "object",
      "required": ["type", "from", "to"],
      "additionalProperties": false,
      "properties": {
        "type": { "$ref": "#/$defs/Text" },
        "from": { "type": "number" },
        "to": { "type": "number" }
      }
    },
    "Track": {
      "type": "object",
      "required": ["id", "epsg", "elements"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "$ref": "#/$defs/Text" },
        "trackType": { "enum": [1, 2] },
        "lineNumber": { "$ref": "#/$defs/Label" },
        "lineName": { "$ref": "#/$defs/Text" },
        "side": { "type": "integer" },
        "trackNumber": { "$ref": "#/$defs/Label" },
        "operationalPoint": { "$ref": "#/$defs/Ref", "x-target": "core.operationalPoints" },
        "owner": { "$ref": "#/$defs/Text" },
        "trackUse": { "const": "siding" },
        "lineCategory": { "$ref": "#/$defs/LineCategory" },
        "lifespan": { "$ref": "#/$defs/Lifespan" },
        "epsg": { "$ref": "#/$defs/Epsg" },
        "heightEpsg": { "$ref": "#/$defs/Epsg" },
        "elements": { "type": "array", "items": { "$ref": "#/$defs/Element" }, "minItems": 1 },
        "heights": { "type": "array", "items": { "$ref": "#/$defs/HeightPoint" } },
        "rails": { "type": "array", "items": { "$ref": "#/$defs/Superstructure" } },
        "sleepers": { "type": "array", "items": { "$ref": "#/$defs/Superstructure" } },
        "lagesystem": { "$ref": "#/$defs/Text", "description": "The DB Lagesystem an MDB import took the track from (EA0, DB0, …)." },
        "proviAxis": { "$ref": "#/$defs/Text", "description": "The ProVI axis an import took the track from." },
        "osrd": { "type": "object", "description": "What a RailJSON import brought along for the track section that the model does not hold, handed back on export." }
      }
    },
    "Switch": {
      "description": "A turnout, crossing, slip or two-end connector (`link`) at a node; its ports hold track ends. A link joins two track ends where the plane changes or where a rebuilt part of a track ties in.",
      "type": "object",
      "required": ["id", "kind", "formVersion", "ports"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["turnout", "crossing", "single_slip", "double_slip", "link"] },
        "formVersion": { "type": "integer" },
        "name": { "$ref": "#/$defs/Text" },
        "number": { "type": "number" },
        "label": { "$ref": "#/$defs/Text" },
        "speed": { "type": "number" },
        "trailing": { "type": "boolean" },
        "swapped": { "type": "boolean" },
        "toeLead": { "const": "branch" },
        "lifespan": { "$ref": "#/$defs/Lifespan" },
        "mainRadius": { "type": ["number", "null"] },
        "mainRadiusEnd": { "type": ["number", "null"] },
        "pad": {},
        "ports": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^(A|B|B1|B2|C|D)$": { "oneOf": [{ "$ref": "#/$defs/TrackEnd" }, { "type": "null" }] }
          }
        }
      }
    },
    "Platform": {
      "type": "object",
      "required": ["id", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "at": { "$ref": "#/$defs/TrackRange" },
        "frontOffset": { "type": "number" },
        "backOffset": { "type": "number" },
        "height": { "type": "number" },
        "operationalPoint": { "$ref": "#/$defs/Ref", "x-target": "core.operationalPoints" },
        "lifespan": { "$ref": "#/$defs/Lifespan" }
      }
    },
    "EndMark": {
      "description": "A buffer stop or the boundary of the planning area at a free track end.",
      "type": "object",
      "required": ["id", "kind", "at"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "kind": { "enum": ["buffer_stop", "boundary"] },
        "at": { "$ref": "#/$defs/TrackEnd" },
        "type": { "type": ["integer", "string"] },
        "brakeLength": { "type": "number" },
        "lifespan": { "$ref": "#/$defs/Lifespan" }
      }
    },
    "KmLine": {
      "description": "Foreign reference data: the stretch of a DB line around the project, in WGS84, the third value of each point its kilometrage [m].",
      "type": "object",
      "required": ["id", "lineNumber", "runs"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "lineNumber": { "$ref": "#/$defs/Label" },
        "crs": { "const": "EPSG:4326" },
        "clip": { "type": "array", "items": { "type": "number" }, "minItems": 4, "maxItems": 4 },
        "runs": {
          "type": "array",
          "items": { "type": "array", "items": { "type": "array", "items": { "type": "number" }, "minItems": 3, "maxItems": 3 } }
        },
        "source": { "$ref": "#/$defs/Text", "description": "The import a line was taken from (mdb, vermesn), kept instead of the shipped one." }
      }
    },
    "OperationalPoint": {
      "description": "A station, halt or other operational point of the register: its identity. Codes are attributes, stated once they exist; boundaries belong to signalling (R10).",
      "type": "object",
      "required": ["id"],
      "anyOf": [{ "required": ["name"] }, { "required": ["rl100"] }, { "required": ["uic"] }],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "#/$defs/Id" },
        "name": { "$ref": "#/$defs/Text" },
        "rl100": { "$ref": "#/$defs/Text" },
        "uic": { "$ref": "#/$defs/Label" }
      }
    }
  }
}
