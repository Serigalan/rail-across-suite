# Rail-Across-Suite — server configuration: one server for the suite, its
# start page, every module's app and the project server with the one sign-in.
#
# Copy to /etc/rail-across/rail-across.env (or anywhere, and hand it to the
# scripts with --config <file>), adjust, then run deploy/setup.sh once and
# deploy/deploy.sh after every update. Every variable has a default; only
# RA_DOMAIN must be set.

# Public host name. Caddy fetches the TLS certificate for it (Let's Encrypt),
# so DNS must point here before setup runs. The start page is its root, the
# Layout-Tool lies under /layout/.
RA_DOMAIN=railacross.example.org

# A second instance on the same machine (e.g. production beside a test
# server): its name goes into the units (rail-across-<name>-server …), the
# default user (rail-across-<name>) and data directory
# (/var/lib/rail-across-<name>). Give it its own ports below. Empty: the plain
# names rail-across-server, rail-across, …
#RA_INSTANCE=

# What deploy.sh may put on this instance:
#   main  git pull of the branch checked out (--pull), every commit — a test server
#   tags  only prod-* tags with a green CI (--ref <tag>, see release.sh)
#RA_TRACK=main

# The checkout of rail-across-suite this file belongs to. Default: the repository
# the scripts live in.
#RA_REPO=/opt/rail-across-suite

# The built site: the start page (apps/home) at its root, each module's app
# under its path (layout/ the Layout-Tool).
#RA_SITE_DIR=$RA_REPO/dist

# System user the services run as. setup.sh creates it if missing; a checkout
# under a closed directory such as /root gets it through with an ACL.
#RA_USER=rail-across

# Everything the services write: database, backups, venv, terrain cache, NTv2
# grids for PROJ. Owned by RA_USER.
#RA_DATA=/var/lib/rail-across
#RA_DB=$RA_DATA/rail-across.sqlite
#RA_BACKUPS=$RA_DATA/backups
#RA_BACKUP_DAYS=30
#RA_VENV=$RA_DATA/venv
#RA_TERRAIN_CACHE=$RA_DATA/terrain-cache
# Point clouds (phase 13): uploads and tiles, some 15 GB a project of 5 km with
# colour, 25 GB at most a project. Not in the daily backup.
#RA_CLOUDS=$RA_DATA/clouds

# Where the services listen. Never 0.0.0.0 — neither service is meant to be
# reachable except through Caddy.
#RA_BIND=127.0.0.1
#RA_SERVER_PORT=8787
#RA_OPTIMIZER_PORT=8099
# Log level of the project server (fatal, error, warn, info, debug).
#RA_SERVER_LOG=info

# Caddy:
#   system    install Caddy from its apt repository, write the site to
#             /etc/caddy/conf.d/rail-across.caddy (default)
#   external  a Caddy that is already running elsewhere (e.g. in a container):
#             the site block is only written to RA_CADDY_DIR, which that
#             Caddy imports (a directory mount sees new files at once)
#RA_CADDY=system
# Where the site block goes (rail-across[-<instance>].caddy).
# Default: /etc/caddy/conf.d (system), $RA_DATA (external).
#RA_CADDY_DIR=/etc/rail-across/caddy
# external: command that makes the running Caddy read it, run by setup.sh.
#RA_CADDY_RELOAD="docker exec osrd-caddy caddy reload --config /etc/caddy/Caddyfile --adapter caddyfile"
# How Caddy reaches the services and the built app. With RA_CADDY=system the
# defaults fit; a containerised Caddy sees other addresses and paths.
#RA_UPSTREAM=$RA_BIND
#RA_SITE_ROOT=$RA_SITE_DIR
# Addresses (or CIDR ranges) Caddy's requests come from; only their
# X-Forwarded-For is believed (the login brake counts per client address).
# A Caddy in a container: its network, e.g. 172.18.0.0/16.
#RA_TRUST_PROXY=127.0.0.1,::1

# First admin, created by setup.sh when the database has no user yet. The start
# password is generated and written to $RA_DATA/admin-start-password.txt.
#RA_ADMIN_LOGIN=admin

# Optimizer service limits (see services/optimizer/olt_optimizer/service.py).
#RA_OPTIMIZER_TIMEOUT=120
#RA_OPTIMIZER_WORKERS=2

# Point cloud jobs: preparations and long runs at once (each in its own
# process), and the memory all of them may take together.
#RA_CLOUDJOBS_PARALLEL=2
#RA_CLOUDRUNS_PARALLEL=2
#RA_CLOUDJOBS_MEMORY=3G
# Memory limits of the other two services (systemd MemoryMax).
#RA_SERVER_MEMORY=infinity
#RA_OPTIMIZER_MEMORY=infinity

# Built into the Layout-Tool: an instance's own MapTiler key (satellite, terrain).
#VITE_MAPTILER_KEY=

# The Node.js the services run with. Default: the one on PATH when setup.sh
# runs — name another where that one is not readable for RA_USER (nvm under /root).
#RA_NODE=/usr/local/bin/node
