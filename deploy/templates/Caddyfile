# Rail-Across-Suite — rendered by deploy/setup.sh from deploy/templates/Caddyfile.
#
# The app is usable only after signing in (phase 10): /api/* is the project
# server. The optimizer and terrain service (/optimizer/*) and the km line data
# (/data/km*) answer only with a valid session — Caddy asks the project server
# (forward_auth against /api/me, which sees the request's own cookie). The app
# files themselves and the NTv2 grids under /data/*.tif stay open: the sign-in
# page is part of the app, and the app loads the grid before anyone signs in.
#
# The site directory holds the suite's start page at its root and each
# module's app under its path — the Layout-Tool under /layout/.
@RA_DOMAIN@ {
	handle /api/* {
		reverse_proxy @RA_UPSTREAM@:@RA_SERVER_PORT@
	}

	# /optimizer/optimize → the service sees /optimize (prefix cut off).
	handle_path /optimizer/* {
		forward_auth @RA_UPSTREAM@:@RA_SERVER_PORT@ {
			uri /api/me
		}
		reverse_proxy @RA_UPSTREAM@:@RA_OPTIMIZER_PORT@
	}

	@kmdata path /layout/data/km/* /layout/data/km_linie.pmtiles
	handle @kmdata {
		forward_auth @RA_UPSTREAM@:@RA_SERVER_PORT@ {
			uri /api/me
		}
		root * @RA_SITE_ROOT@
		file_server
	}

	handle {
		root * @RA_SITE_ROOT@
		file_server
	}

	encode zstd gzip
	log
}
