# Dependencies and environments, in every app, package and service
node_modules/
.venv/
__pycache__/
*.egg-info/

# Builds: the start page, and the suite's site (deploy, OLT_PATH other than /)
/dist/
apps/home/dist/
/.tmp-build-*/

# The cargo workspace's builds (decision 0020), and those of before it
/target/
sim/target/
crossover/target/
optimizer/target/
# The core's WebAssembly module, built by packages/core/scripts/wasm.mjs
/packages/core/wasm/
# The point cloud import's WebAssembly module, built by packages/pointcloud/scripts/wasm.mjs
/packages/pointcloud/wasm/
apps/*/public/core-module/
