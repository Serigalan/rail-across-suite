{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Rail-Across-Suite",
  "version": "0.2.0",
  "identifier": "dev.railacross.suite",
  "build": {
    "beforeBuildCommand": "node scripts/build-site.mjs && node scripts/stage-mdbtools.mjs",
    "frontendDist": "ui"
  },
  "app": {
    "withGlobalTauri": true,
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "resources": {
      "site/": "site/",
      "mdbtools/": "mdbtools/"
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "macOS": {
      "signingIdentity": "-"
    }
  }
}
